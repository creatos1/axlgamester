modules = ["nodejs-20", "web"]
run = "npm run watch"

[nix]
channel = "stable-25_05"

[deployment]
run = ["sh", "-c", "ng serve --host 0.0.0.0 --port 5000 --disable-host-check false"]
build = ["sh", "-c", "ng build --configuration production --aot --build-optimizer --optimization --output-hashing=all"]

[agent]
expertMode = true
