
{
  "/api/youtube/*": {
    "target": "https://www.googleapis.com",
    "secure": true,
    "changeOrigin": true,
    "logLevel": "debug",
    "pathRewrite": {
      "^/api/youtube": "/youtube/v3"
    },
    "headers": {
      "Accept": "application/json",
      "User-Agent": "Angular-App/1.0"
    }
  }
}
